# Integrated development/server listener (default: 3000)
PORT=3000

# Optional standalone API listener used with `pnpm dev:backend` (default: 3001)
OUTDOORIQ_API_PORT=3001

# Optional frontend API origin. Leave blank for the integrated same-origin app.
# With separately served frontend/backend, the Vite dev proxy is configured to the standalone API.
VITE_OUTDOORIQ_API_BASE_URL=

# Comma-separated allowed browser origins for the standalone API's CORS responses.
# Same-origin integrated use needs no CORS setting.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External provider request timeout in milliseconds (bounded by the app to 1.5–30 seconds).
OUTDOORIQ_HTTP_TIMEOUT_MS=9000

# Identify your app for OpenStreetMap Nominatim requests; use a contact address you control.
# The app throttles Nominatim fallback requests and caches geocoding results.
OUTDOORIQ_USER_AGENT=OutdoorIQ/1.0 (contact: you@example.com)

# Optional OpenAI-compatible local or hosted chat-completions service.
# Supply the base URL through /v1, e.g. http://localhost:8000/v1; the app appends /chat/completions.
# Leave SLM_BASE_URL and SLM_MODEL blank to use deterministic explanations only.
SLM_BASE_URL=
SLM_MODEL=
SLM_API_KEY=
SLM_TIMEOUT_MS=8000

# Relative OutdoorIQ score weights (0–100; missing data dimensions are excluded and remaining weights renormalized).
# Defaults total 100; set one or more values to tune activity-fit, distance, conditions, air and timing contributions.
OUTDOORIQ_SCORE_WEIGHT_PLACE_FIT=38
OUTDOORIQ_SCORE_WEIGHT_DISTANCE=18
OUTDOORIQ_SCORE_WEIGHT_CONDITIONS=22
OUTDOORIQ_SCORE_WEIGHT_AIR_QUALITY=17
OUTDOORIQ_SCORE_WEIGHT_TIMING=5

# The initialized Manus runtime provides its own platform variables when needed by starter helpers.
# Do not put private API keys in VITE_* variables; VITE_* values are bundled for browsers.
